# Image untuk automated test (lint + unit). BUKAN image runtime.
#
# Source di-COPY ke dalam image (BUKAN bind-mount). Konsekuensinya:
#  - Test berjalan terisolasi; hasil sama di mesin developer manapun dan di CI.
#  - Artefak test (__pycache__, .pytest_cache, dll) hidup di dalam container
#    dan ikut terhapus saat `docker run --rm`. Folder project di host tetap bersih.
#
# Pin Python 3.12-slim untuk parity lokal vs CI.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=5

# postgresql-client-16 dari repositori resmi PGDG — WAJIB versi 16, bukan paket
# `postgresql-client` bawaan Debian bookworm (versi 15): harness test memakai service
# `postgres:16-alpine` (docker-compose.test.yml), dan `pg_dump`/`pg_restore` 15 MENOLAK
# melayani server 16 ("server version mismatch"). Tanpa ini, test integrasi
# backup/restore (backlog 025) gagal karena biner `pg_dump`/`pg_restore` tidak ada.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor -o /usr/share/keyrings/postgresql.gpg \
    && . /etc/os-release \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-16 \
    && apt-get purge -y --auto-remove curl gnupg \
    && rm -rf /var/lib/apt/lists/* /etc/apt/sources.list.d/pgdg.list

# Install dependency aplikasi dari pyproject.toml + tooling test (versi dipin).
# Urutan ini mengoptimalkan cache layer Docker: deps jarang berubah, source sering.
COPY pyproject.toml README.md requirements-test.txt ./
COPY src ./src
RUN pip install --no-cache-dir . \
    && pip install --no-cache-dir -r requirements-test.txt

# Copy seluruh source termasuk tests/ (pengecualian diatur di .dockerignore).
COPY . .
