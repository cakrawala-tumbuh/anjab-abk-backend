# Konfigurasi backend (12-factor). Salin ke `.env` lalu sesuaikan.

# Identitas & logging
APP_TITLE="ANJAB-ABK Backend"
LOG_LEVEL=INFO

# Bind Uvicorn
HOST=0.0.0.0
PORT=8000

# Dokumentasi API
DOCS_ENABLED=true

# URL publik service → mengisi `servers` di OpenAPI
# PUBLIC_BASE_URL=https://api.example.com

# CORS — daftar origin (format JSON).
# CORS_ORIGINS=["https://app.example.com"]
CORS_ALLOW_CREDENTIALS=false

# Hardening HTTP
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=0
ENABLE_SECURITY_HEADERS=true
ENABLE_HSTS=false
ENABLE_COOP=true
GZIP_MIN_SIZE=1024
REQUIRE_IF_MATCH=false

# ==== Koneksi PostgreSQL ======================================================
# Sediakan DATABASE_URL lengkap ATAU komponen DB_* di bawah. Bila DATABASE_URL
# diisi, ia menang. JANGAN commit kredensial nyata — ini hanya contoh.
# DATABASE_URL=postgresql+psycopg://app:secret@127.0.0.1:5432/anjab_abk
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=app
DB_PASSWORD=
DB_NAME=anjab_abk
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_ECHO=false
DB_IDEMPOTENCY_TTL_SECONDS=86400

# Auth — parameter validasi token Authentik (seam; tidak ada koneksi langsung di sini)
# AUTHENTIK_ISSUER=https://auth.example.com/application/o/anjab-abk/
# AUTHENTIK_JWKS_URI=https://auth.example.com/application/o/anjab-abk/jwks/
# API_AUDIENCE=anjab-abk

# OAuth2 interaktif untuk Swagger "Authorize" (opsional, doc-only)
# OAUTH2_AUTHORIZATION_URL=https://auth.example.com/application/o/authorize/
# OAUTH2_TOKEN_URL=https://auth.example.com/application/o/token/
# OAUTH2_CLIENT_ID=swagger-ui
# OAUTH2_SCOPES=openid profile email

# Authentik Admin API — untuk provisioning akun partisipan.
# Buat API token di Authentik > System > Tokens (tipe: API Token).
# AUTHENTIK_PARTISIPAN_GROUP_ID adalah UUID grup "partisipan" di Authentik.
# AUTHENTIK_API_URL=https://auth.example.com
# AUTHENTIK_API_TOKEN=your-admin-api-token-here
# AUTHENTIK_PARTISIPAN_GROUP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Feature flag fungsional (default false = mati; berubah hanya lewat env + restart)
# FEATURE_AI_NARRATIVE_DRAFT=false
# FEATURE_PARTICIPANT_VALIDATION=false
# FEATURE_WCP_DCS_SCORING=false
# FEATURE_RESEARCH_EXPORT=false
# FEATURE_CHANGE_AUTHORIZATION=false
# FEATURE_PREBANK_FREEZE=false

# Register run AI
# AI_PROTOCOL_ARM=TANPA_ARM
# AI_SIMPAN_MASUKAN=false

# Gerbang redaksi PII sebelum model (bawaan paling ketat)
# AI_JENIS_SUMBER_DIIZINKAN=["SINTETIS"]
# AI_PII_MODE=BLOKIR

# Klien model Claude. Mode, model, effort, dan kunci API diatur admin lewat UI (pengaturan
# penyedia di basis data); env ANTHROPIC_API_KEY, AI_MODEL, dan AI_EFFORT diabaikan.
# AI_MAX_TOKENS=16000
# AI_TIMEOUT_DETIK=300
# AI_INFERENCE_GEO=
# AI_REFUSAL_FALLBACK=true

# Kunci induk Fernet pengenkripsi kunci API penyedia AI (diisi deployment; jangan di-commit)
# AI_KREDENSIAL_KUNCI_INDUK=

# Worker job AI (python -m anjab_abk_backend.ai.worker; keluar bila flag mati)
# AI_WORKER_POLL_DETIK=5
# AI_JOB_MAKS_PERCOBAAN=3
